{
	"name": "n8n-nodes-ollama-reranker",
	"version": "1.6.0",
	"description": "Reranker nodes for n8n - Custom rerank API (recommended), VL Classifier, Ollama Generate (experimental). Vector Store provider + workflow node.",
	"author": "Gabriel BRUMENT",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/theseedship/n8n_reranker.git"
	},
	"bugs": {
		"url": "https://github.com/theseedship/n8n_reranker/issues"
	},
	"homepage": "https://github.com/theseedship/n8n_reranker#readme",
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc && node scripts/copy-icons.js",
		"dev": "tsc --watch",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"test": "jest",
		"format": "prettier --write \"**/*.{ts,js,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
		"prepare": "cd .. && husky custom-nodes/.husky"
	},
	"keywords": [
		"n8n",
		"n8n-nodes",
		"n8n-community-node-package",
		"ollama",
		"reranker",
		"vector-store",
		"rag",
		"ai"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"nodes": [
			"dist/nodes/OllamaReranker/OllamaReranker.node.js",
			"dist/nodes/OllamaRerankerWorkflow/OllamaRerankerWorkflow.node.js"
		],
		"credentials": []
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"eslint": "^8.57.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^15.5.2",
		"n8n-workflow": "^1.120.0",
		"prettier": "^3.4.2",
		"ts-jest": "^29.4.0",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"form-data": "^4.0.5"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	}
}
